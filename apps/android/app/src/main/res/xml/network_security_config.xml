<?xml version="1.0" encoding="utf-8"?>
<!-- Home servers usually run on plain http://192.168.x.x:8888 inside your own
     network, so cleartext must be allowed. Use https:// for anything public. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
