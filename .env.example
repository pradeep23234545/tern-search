# Copy this file to ".env" and fill it in. ".env" is never committed to Git.
#   PowerShell:      Copy-Item .env.example .env ; .\scripts\new-secret.ps1
#   Ubuntu/WSL/Mac:  cp .env.example .env && ./scripts/new-secret.sh

# ---- Required -------------------------------------------------------------
# Secret used to sign cookies. Generate your own with the script above.
# Never share it or commit it.
SEARXNG_SECRET=CHANGE_ME_RUN_THE_NEW_SECRET_SCRIPT

# ---- Where it listens (local) ---------------------------------------------
# 127.0.0.1 = only this computer. 0.0.0.0 = also other devices on your network.
BIND_ADDRESS=127.0.0.1
# Port on your computer. 8888 avoids clashing with other apps that use 8080.
HOST_PORT=8888

# Pin a version for repeatable installs, e.g. 2026.11.2-cccbc9e15, or "latest".
SEARXNG_VERSION=latest

# ---- Only for public HTTPS (docker compose --profile public up -d) ---------
# The public address of your instance, with trailing slash.
#SEARXNG_BASE_URL=https://search.example.org/
# Domain Caddy requests a free Let's Encrypt certificate for.
#TERN_HOSTNAME=search.example.org
# Email Let's Encrypt uses for expiry notices.
#TERN_ACME_EMAIL=you@example.org
# Turn on bot protection when the instance is reachable from the internet.
#SEARXNG_LIMITER=true
#SEARXNG_PUBLIC_INSTANCE=false
